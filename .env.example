# Connexion PostgreSQL (Neon : Dashboard > Connect > chaîne « Pooled connection »)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Mot de passe de l'organisateur
ORGANIZER_PASSWORD=change-moi
# Secret de signature des cookies de session (chaîne aléatoire longue)
SESSION_SECRET=une-longue-chaine-aleatoire
